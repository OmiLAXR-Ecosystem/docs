# OmiLAXR docs (Astro Starlight)
# Usage: make <target>
# Notes:
# - Package docs are generated by OmiLAXR.MCP (export-docs) and need the .NET 10 SDK
# - Pushes to main are deployed to GitHub Pages (.github/workflows/deploy.yml)
# - The package Makefiles call the package-* targets with PKG=<package dir>

NPM ?= npm
WORKSPACE ?= ..

.DEFAULT_GOAL := help

.PHONY: help install packages local dev build preview clean check new-page new-component publish

help: ## Show available commands
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2}'

install: ## Install dependencies from package-lock.json
	$(NPM) ci

node_modules: package-lock.json
	$(NPM) ci
	@touch node_modules

packages: ## Clone the package repos (main) into .packages/ and generate their docs
	node scripts/packages.mjs

local: ## Generate the docs from the repos in WORKSPACE (default ..)
	node scripts/packages.mjs --local $(WORKSPACE)

dev: node_modules ## Start the dev server with hot reload
	$(NPM) run dev

build: node_modules ## Build the site into dist/
	$(NPM) run build

preview: build ## Build and serve the production site locally
	$(NPM) run preview

clean: ## Remove build output, caches, clones and generated docs
	rm -rf dist .astro .packages
	node -e 'const fs=require("fs");const f="src/generated/packages.json";if(fs.existsSync(f)){for(const p of JSON.parse(fs.readFileSync(f,"utf8")))fs.rmSync("src/content/docs/"+p.slug,{recursive:true,force:true});fs.rmSync("src/generated",{recursive:true,force:true})}'

check: ## List components of PKG without a <summary>
	@test -n "$(PKG)" || (echo "Set PKG=<package dir>"; exit 2)
	node scripts/packages.mjs --local $(abspath $(PKG)/..) --check $(PKG)

new-page: ## Create Documentation~/<NAME>.md in PKG
	@test -n "$(PKG)" -a -n "$(NAME)" || (echo "Set PKG=<package dir> NAME=<path>"; exit 2)
	node scripts/new-page.mjs $(PKG) $(NAME)

new-component: ## Create Documentation~/components/<NAME>.md in PKG
	@test -n "$(PKG)" -a -n "$(NAME)" || (echo "Set PKG=<package dir> NAME=<ClassName>"; exit 2)
	node scripts/new-page.mjs $(PKG) --component $(NAME)

publish: ## Rebuild docs.omilaxr.dev now (needs the GitHub CLI)
	gh workflow run deploy.yml -R OmiLAXR-Ecosystem/docs
